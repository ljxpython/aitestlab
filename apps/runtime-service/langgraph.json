{
  "$schema": "https://langgra.ph/schema.json",
  "python_version": "3.13",
  "dependencies": ["."],
  "http": {
    "app": "./src/runtime_service/webapp.py:app"
  },
  "graphs": {
    "reference_agent": {
      "path": "./src/runtime_service/graphs/reference_agent.py:get_agent",
      "description": "R2 Runtime-aware create_agent reference service with explicit model resolution."
    },
    "workflow_demo": {
      "path": "./src/runtime_service/graphs/workflow_demo.py:get_agent",
      "description": "Model-backed workflow Agent with optional human confirmation interrupt."
    }
  },
  "env": ".env",
  "auth": {
    "path": "./src/runtime_service/auth/platform.py:auth",
    "openapi": {
      "securitySchemes": {
        "RuntimeBearer": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      },
      "security": [
        {
          "RuntimeBearer": []
        }
      ]
    }
  }
}
