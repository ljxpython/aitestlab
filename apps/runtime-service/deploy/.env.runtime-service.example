# Runtime-service single-app container deployment env template
#
# Python baseline for the runtime image:
# PYTHON_VERSION=3.13
#
# This file is the only Compose deploy-time env input.
# Inject real model credentials here from the deploy secret store; never commit
# them to this template and never rely on apps/runtime-service/.env in a container.

# Image/build
PYTHON_VERSION=3.13
RUNTIME_SERVICE_IMAGE=aitestlab-runtime-service:local
GRAPHHARBOR_ENV=production
N_JOBS_PER_WORKER=1

# Ports
RUNTIME_SERVICE_PORT=8123

# Runtime dependencies
RUNTIME_POSTGRES_HOST=postgres
RUNTIME_POSTGRES_PORT=5432
RUNTIME_POSTGRES_DB=runtime_service
RUNTIME_POSTGRES_USER=runtime_service
RUNTIME_POSTGRES_PASSWORD=runtime_service
RUNTIME_REDIS_HOST=redis
RUNTIME_REDIS_PORT=6379
RUNTIME_REDIS_DB=0

# Runtime env baseline
APP_ENV=test
RUNTIME_MODEL_PROFILE=production
MODEL_ID=
BG_JOB_ISOLATED_LOOPS=true
PLATFORM_RUNTIME_DELEGATION_SECRET=
PLATFORM_RUNTIME_DELEGATION_ISSUER=platform-api
PLATFORM_RUNTIME_DELEGATION_AUDIENCE=runtime-service
PLATFORM_RUNTIME_DELEGATION_ALGORITHM=RS256
PLATFORM_RUNTIME_DELEGATION_JWKS_URL=
PLATFORM_RUNTIME_MANAGEMENT_API_KEY=

# Unified model proxy. Runtime production must not use provider API keys directly.
MODEL_PROXY_URL=
MODEL_PROXY_AUDIENCE=model-proxy
MODEL_PROXY_JWKS_URL=
MODEL_PROXY_SECRET_STORE_REF=

# Model credentials. These are required for reference_agent and must be supplied
# by the deploy secret store or this file; they are never baked into the image.
DEEPSEEK_PROXY_URL=
DEEPSEEK_PROXY_API_KEY=
DEEPSEEK_PROXY_DEFAULT_MODEL=
DEEPSEEK_PROXY_SUPPORTED_MODELS=
GPT_PROXY_URL=
GPT_PROXY_API_KEY=
GPT_PROXY_DEFAULT_MODEL=

# GraphHarbor internal API-to-Worker RuntimeContext envelope
# This is separate from the external Platform delegation JWT secret above.
GRAPHHARBOR_RUNTIME_CONTEXT_SECRET=
GRAPHHARBOR_RUNTIME_CONTEXT_ISSUER=https://runtime-service.internal
GRAPHHARBOR_RUNTIME_CONTEXT_AUDIENCE=graphharbor-worker
GRAPHHARBOR_WORKSPACE_ROOT=/var/lib/runtime-service/workspaces
RUNTIME_WORKSPACE_MAX_FILE_BYTES=10485760
RUNTIME_WORKSPACE_MAX_FILES=10000
RUNTIME_WORKSPACE_MAX_TOTAL_BYTES=1073741824
RUNTIME_WORKSPACE_TTL_SECONDS=604800

# Optional Worker run deadline. Set a positive value in seconds for production;
# override the default when a shorter acceptance deadline is required.
GRAPHHARBOR_RUN_TIMEOUT_SECONDS=300

# OpenTelemetry/Langfuse exporter queue. Keep bounded so exporter backpressure cannot block Runs.
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_SERVICE_NAME=runtime-service
# Optional independent OTLP HTTP trace destination. Keep credentials in the secret store.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10

# Optional runtime defaults
SYSTEM_PROMPT=
# Shared MultimodalMiddleware parser model default
MULTIMODAL_PARSER_MODEL_ID=gpt_5.4-ccr
ENABLE_TOOLS=
TOOLS=
MIDDLEWARES=

# GraphHarbor owns checkpoint/store persistence through DATABASE_URI/REDIS_URI.
# API and Worker are separate processes; migration runs as a one-shot Compose service.

# Optional service-private knowledge MCP defaults
TEST_CASE_V2_KNOWLEDGE_MCP_ENABLED=
TEST_CASE_V2_KNOWLEDGE_MCP_URL=
TEST_CASE_V2_KNOWLEDGE_TIMEOUT_SECONDS=
TEST_CASE_V2_KNOWLEDGE_SSE_READ_TIMEOUT_SECONDS=

# Recommended examples:
# - service runs on host machine:
#   TEST_CASE_V2_KNOWLEDGE_MCP_URL=http://host.docker.internal:8621/sse
# - service runs on public/internal reachable host:
#   TEST_CASE_V2_KNOWLEDGE_MCP_URL=https://mcp.example.com/sse

# Optional auth mode inputs
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TIMEOUT_SECONDS=

# Optional remote persistence target for test_case_service / test_case_service_v2
# Example when interaction-data-service runs on the host:
# INTERACTION_DATA_SERVICE_URL=http://host.docker.internal:8081
INTERACTION_DATA_SERVICE_URL=
INTERACTION_DATA_SERVICE_TOKEN=
INTERACTION_DATA_SERVICE_TIMEOUT_SECONDS=10

# Optional extra tracing/upstream values
#
# Lite mode:
# - provide LANGSMITH_API_KEY
# - leave LANGGRAPH_CLOUD_LICENSE_KEY empty
# - LANGSMITH_ENDPOINT should point to the public or self-hosted LangSmith base URL
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
